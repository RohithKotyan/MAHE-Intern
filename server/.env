# ============================================
# AgroCare AI - Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection (use local or dummy for now)
MONGO_URI=mongodb://localhost:27017/agrocare-ai

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_development_only
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary (optional for now)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=